{
    "$schema": "https://v2-8-12.turborepo.dev/schema.json",
    "tasks": {
        "build": {
            "dependsOn": [ "^build" ],
            "outputs": [ "dist/**", "native/*.node" ]
        },
        "typecheck": {
            "dependsOn": [ "^build" ]
        },
        "lint": {
            "dependsOn": [ "^build" ]
        },
        "test": {
            "dependsOn": [ "^build" ]
        },
        "lint:fix": {
            "cache": false
        },
        "format": {
            "cache": false
        }
    }
}
