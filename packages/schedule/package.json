{
    "name": "@signalbox/schedule",
    "version": "0.2.3",
    "license": "MIT",
    "description": "signalbox plugin: schedule one-shot and cron jobs (timezone-aware, via Croner)",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Niikelion/signalbox.git",
        "directory": "packages/schedule"
    },
    "type": "module",
    "main": "dist/index.cjs",
    "module": "dist/index.js",
    "types": "dist/index.d.ts",
    "files": [
        "/dist"
    ],
    "exports": {
        "import": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "require": {
            "types": "./dist/index.d.cts",
            "require": "./dist/index.cjs"
        }
    },
    "scripts": {
        "build": "tsc --noEmit && tsdown",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "test:watch": "vitest",
        "lint": "eslint src",
        "lint:fix": "eslint src --fix",
        "format": "prettier --write ."
    },
    "dependencies": {
        "@signalbox/core": "^0.5.0",
        "croner": "^9.0.0"
    },
    "devDependencies": {
        "@arethetypeswrong/core": "^0.18.2",
        "@gamedev-sensei/ts-config": "^2.1.0",
        "@signalbox/shared-config": "^0.1.0",
        "@types/node": "^22.10.2",
        "@vitest/coverage-v8": "^2.1.9",
        "eslint": "^9.39.2",
        "prettier": "^3.8.1",
        "tsdown": "^0.15.7",
        "typescript": "^5.9.3",
        "vitest": "^2.1.9"
    }
}
