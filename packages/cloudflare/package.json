{
    "name": "@flowkit/cloudflare",
    "version": "0.1.0",
    "license": "MIT",
    "description": "FlowKit plugin: keep Cloudflare DNS A records pointed at a changing address",
    "type": "module",
    "main": "dist/index.cjs",
    "module": "dist/index.js",
    "types": "dist/index.d.ts",
    "files": [
        "/dist"
    ],
    "exports": {
        "import": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "require": {
            "types": "./dist/index.d.cts",
            "require": "./dist/index.cjs"
        }
    },
    "scripts": {
        "build": "tsc --noEmit && tsdown",
        "typecheck": "tsc --noEmit",
        "lint": "eslint src",
        "lint:fix": "eslint src --fix",
        "format": "prettier --write ."
    },
    "dependencies": {
        "@flowkit/core": "workspace:^",
        "@flowkit/graph": "workspace:^"
    },
    "devDependencies": {
        "@arethetypeswrong/core": "^0.18.2",
        "@flowkit/shared-config": "workspace:^",
        "@gamedev-sensei/ts-config": "^2.1.0",
        "@types/node": "^22.10.2",
        "eslint": "^9.39.2",
        "prettier": "^3.8.1",
        "tsdown": "^0.15.7",
        "typescript": "^5.9.3"
    }
}
