{
    "name": "flowkit",
    "private": true,
    "packageManager": "yarn@4.18.0",
    "workspaces": [
        "packages/*",
        "apps/*",
        "!**/dist"
    ],
    "scripts": {
        "build": "turbo build",
        "typecheck": "turbo typecheck",
        "lint": "turbo lint",
        "format": "turbo format",
        "changeset": "changeset",
        "release": "turbo build && changeset publish"
    },
    "devDependencies": {
        "@changesets/cli": "^2.29.7",
        "tsdown": "^0.15.7",
        "turbo": "^2.8.20",
        "typescript": "^5.9.3"
    }
}
